# Copy to .env.local; secrets never belong in Git. All values below are placeholders.
PRESIDIUM_MATRIX_HOMESERVER_URL=
PRESIDIUM_MATRIX_PUBLIC_URL=
PRESIDIUM_PRODUCT_DATA_DIR=
PRESIDIUM_NODE_BIN=
# Next server proxy; default is http://127.0.0.1:8000
PRESIDIUM_API_PROXY_URL=

# Explicit local sandbox only; 1 enables pretend payments, with no real charge.
COMMISSIONKA_SANDBOX_ORDERS=
COMMISSIONKA_VAT_MODE=
COMMISSIONKA_DELIVERY_KOPECKS=
COMMISSIONKA_PAYMENT_OPERATOR_KOPECKS=
# Comma-separated Matrix IDs; subscriptions/seller status never imply moderation rights.
PRESIDIUM_MODERATOR_IDS=

# Signed billing webhook; minimum 32 characters. Never expose to the browser.
PRESIDIUM_BILLING_WEBHOOK_SECRET=
# HTTPS provider accepting {question,materials,max_output_tokens}, returning {answer}.
CAPSULE_AGENT_URL=
CAPSULE_AGENT_TOKEN=
CAPSULE_AI_INPUT_PRICE_MICRO_USD_PER_MILLION=
CAPSULE_AI_OUTPUT_PRICE_MICRO_USD_PER_MILLION=
CAPSULE_AI_MONTHLY_BUDGET_MICRO_USD=

PRESIDIUM_UPDATE_PUBLIC_KEY=
PRESIDIUM_POSTGRES_PASSWORD=
PRESIDIUM_MINIO_PASSWORD=

# Web auth: authoritative Matrix server (no admin secret in browser)
PRESIDIUM_MATRIX_SERVER_NAME=presidium.local
PRESIDIUM_SESSION_SECONDS=2592000
# Optional fixed external HTTPS origin; run-local --lan-host sets it automatically
PRESIDIUM_PUBLIC_ORIGIN=
PRESIDIUM_MATRIX_PROXY_URL=http://127.0.0.1:8008
