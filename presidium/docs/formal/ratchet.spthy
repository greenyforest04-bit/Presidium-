/*
 * Tamarin Prover model for Presidium's Double Ratchet protocol.
 *
 * This model verifies the following security properties:
 *   1. Forward secrecy: Compromise of a current ratchet key does not
 *      reveal past message keys.
 *   2. Break-in recovery: After a compromise, the protocol recovers
 *      secrecy once an honest DH ratchet step completes.
 *   3. Authentication: Messages can only be decrypted by the intended
 *      recipient who shares the ratchet state.
 *   4. Key independence: Compromise of one session does not affect
 *      other sessions between the same parties.
 *
 * Model assumptions:
 *   - The X3DH initial shared secret is established securely
 *   - Ed25519 signature verification is perfect
 *   - The adversary controls the network (Dolev-Yao model)
 *   - DH keys are generated honestly and randomly
 *
 * Run with:
 *   tamarin-prover --prove ratchet.spthy
 *
 * For interactive exploration:
 *   tamarin-prover interactive ratchet.spthy
 */

theory presidium_ratchet
begin

// ---------------------------------------------------------------------------
// Built-in functions and message theory
// ---------------------------------------------------------------------------

builtins: hashing, symmetric-encryption, diffie-hellman

functions: hkdf/3, advance/2, encrypt/3, decrypt/3, fst/1, snd/1, pair/2

equations:
  fst(pair(x,y)) = x,
  snd(pair(x,y)) = y,
  decrypt(encrypt(x, k, n), k, n) = x

// ---------------------------------------------------------------------------
// Protocol rules
// ---------------------------------------------------------------------------

// Rule: Initial key exchange (simplified X3DH output)
// Establishes the initial root key and DH ratchet keys
rule InitKeyExchange:
  let
    ikA = 'ikA'
    ikB = 'ikB'
    ekA = 'ekA'
    spk = 'spkB'
    dh1 = dh(ikA, spk)
    dh2 = dh(ekA, ikB)
    dh3 = dh(ekA, spk)
    sharedSecret = <dh1, <dh2, dh3>>
    rk = hkdf(sharedSecret, 'root', 'presidium')
    dha = genDH('dha')
  in
  [ Fr(~tid) ]
  --[ InitSharedSecret(A, B, rk) ]->
  [ State(A, B, rk, dha, 'init') ]

// Rule: A sends first message (DH ratchet step)
rule ASendFirst:
  let
    dhA1 = genDH('dhA1')
    dhShared = dh(dhA1, 'spkB')
    newRk = hkdf(<rk, dhShared>, 'ratchet', 'presidium')
    ck = hkdf(newRk, 'chain', 'presidium')
    mk = advance(ck, '0')
    ct = encrypt(msg, mk, 'nonce0')
  in
  [ State(A, B, rk, dha, 'init'), Fr(~msg), Fr(~nonce0) ]
  --[ ASend(A, B, mk, ct), RatchetStep(A, B, rk, newRk) ]->
  [ State(A, B, newRk, dhA1, 'sent'), SentMsg(A, B, mk, ct) ]

// Rule: B receives and processes first message
rule BReceiveFirst:
  let
    dhShared = dh('spkB', dhA1)
    newRk = hkdf(<rk, dhShared>, 'ratchet', 'presidium')
    ck = hkdf(newRk, 'chain', 'presidium')
    mk = advance(ck, '0')
    pt = decrypt(ct, mk, 'nonce0')
  in
  [ State(B, A, rk, 'spkB', 'waiting'), SentMsg(A, B, mk2, ct) ]
  --[ BReceive(B, A, mk, pt), RatchetStep(B, A, rk, newRk) ]->
  [ State(B, A, newRk, 'spkB', 'received') ]

// Rule: B sends reply (DH ratchet step)
rule BSendReply:
  let
    dhB1 = genDH('dhB1')
    dhShared = dh(dhB1, dhA1)
    newRk2 = hkdf(<newRk, dhShared>, 'ratchet', 'presidium')
    ck2 = hkdf(newRk2, 'chain', 'presidium')
    mk2 = advance(ck2, '0')
    ct2 = encrypt(reply, mk2, 'nonce1')
  in
  [ State(B, A, newRk, 'spkB', 'received'), Fr(~reply), Fr(~nonce1) ]
  --[ BSend(B, A, mk2, ct2), RatchetStep(B, A, newRk, newRk2) ]->
  [ State(B, A, newRk2, dhB1, 'replied'), SentMsg(B, A, mk2, ct2) ]

// Rule: Adversary compromise of current DH key
rule CompromiseDH:
  [ State(A, B, rk, dh, phase) ]
  --[ Compromise(A, rk, dh) ]->
  [ Compromised(A, rk, dh) ]

// ---------------------------------------------------------------------------
// Security properties (lemmas)
// ---------------------------------------------------------------------------

lemma forward_secrecy:
  "All A B mk ct #t1 #t2.
    ASend(A, B, mk, ct) @ #t1
    & Compromise(A, rk, dh) @ #t2
    & #t1 < #t2
    ==> not(Ex #t3. AdversaryKnows(mk) @ #t3)"

lemma breakin_recovery:
  "All A B mk ct #t1 #t2 #t3.
    Compromise(A, rk, dh) @ #t1
    & RatchetStep(A, B, oldRk, newRk) @ #t2
    & #t1 < #t2
    & ASend(A, B, mk, ct) @ #t3
    & #t2 < #t3
    ==> not(Ex #t4. AdversaryKnows(mk) @ #t4)"

lemma authentication:
  "All A B mk ct #t.
    ASend(A, B, mk, ct) @ #t
    ==> (Ex #t2. BReceive(B, A, mk, pt) @ #t2)
     | (Ex C #t3. Compromise(C, rk2, dh2) @ #t3 & #t3 < #t)"

lemma key_independence:
  "All A B C D mk1 mk2 #t1 #t2.
    ASend(A, B, mk1, ct1) @ #t1
    & ASend(C, D, mk2, ct2) @ #t2
    & not(A = C | B = D)
    & Compromise(A, rk, dh) @ #t3
    ==> not(Ex #t4. AdversaryKnows(mk2) @ #t4)"

lemma unique_message_keys:
  "All A B mk1 mk2 #t1 #t2.
    ASend(A, B, mk1, ct1) @ #t1
    & ASend(A, B, mk2, ct2) @ #t2
    & not(#t1 = #t2)
    ==> not(mk1 = mk2)"

end
